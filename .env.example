# Flask
FLASK_DEBUG=false

# PostgreSQL — required
DATABASE_NAME=hackathon_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis — optional (Gold tier only)
# Leave empty to disable caching (Bronze/Silver). Set to enable Redis-backed redirect cache.
# Example: redis://redis:6379/0
REDIS_URL=

# Cache TTL in seconds (default: 60). How long redirect targets stay cached in Redis.
CACHE_TTL_SECONDS=60
